# Database Configuration (Local MySQL or Cloud MySQL like Aiven / TiDB Cloud / Railway)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tourism_db
DB_SSL=false

# Server Port (Render / Railway assign this automatically)
PORT=5000

# Optional: Gmail SMTP Configuration for sending newsletter welcome emails
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
